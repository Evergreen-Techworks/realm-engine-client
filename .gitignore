learnings/
/.code-health
/.ik-jscpd
# NOTE: this must exclude the CONTENTS (/docs/*), not the directory (/docs).
# git never descends into an excluded directory, so a `!` negation inside one
# is silently dead — which is why /docs/plans stayed untracked.
/docs/*
# …but keep the implementation plans: they are the design record for the
# refactors (plans 70+), referenced by commit messages and by the agents that
# execute them. Without this the entire rationale for a change lives on one machine.
!/docs/plans/

# ── Build artifacts stripped for distribution (regenerate — see SETUP.md) ──
# il2cpp dump (Il2CppInspectorPro output) — ~94 MB, regenerate per game version.
internal/src/game/generated/
# RotMG game data — fetch with `npm run download-game-xml` (see SETUP.md).
client/data/objects.xml
client/data/tiles.xml
internal/data/objects.xml

# ── Local tooling ──
/tools/
/.idea/

# Native artifacts built by the build, not committed. build-all.bat builds them
# locally; the automated builder uses automation/build-native-tools.ps1 and
# build-prod.mjs. Committing them shipped binaries as current as whoever last
# built them by hand, and added a fresh multi-MB blob to history each time.
client/assets/realm-engine.dll
client/assets/winhttp.dll
client/assets/injector.exe
client/winhttp-proxy/winhttp.dll
client/assets/*.obj
